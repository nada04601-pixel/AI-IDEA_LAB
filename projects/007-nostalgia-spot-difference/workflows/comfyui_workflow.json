{
  "_comment": "ComfyUI API 형식(Save (API Format)) 기본 txt2img 워크플로. %CKPT% %PROMPT% %NEGATIVE% %SEED% %WIDTH% %HEIGHT% 는 실행 시 바뀐다. 본인 워크플로로 교체해도 된다.",
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "%SEED%",
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "%CKPT%"}
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {"width": "%WIDTH%", "height": "%HEIGHT%", "batch_size": 1}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "%PROMPT%", "clip": ["4", 1]}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "%NEGATIVE%", "clip": ["4", 1]}
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["3", 0], "vae": ["4", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "nostalgia", "images": ["8", 0]}
  }
}
