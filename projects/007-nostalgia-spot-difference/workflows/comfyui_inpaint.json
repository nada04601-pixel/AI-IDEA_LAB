{
  "_comment": "ComfyUI API 형식 인페인팅 워크플로. 업로드한 그림의 투명한 부분(MASK)만 %PROMPT%대로 다시 그린다. %IMAGE% %CKPT% %PROMPT% %NEGATIVE% %SEED% 는 실행 시 바뀐다.",
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "%IMAGE%"}
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "%CKPT%"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "%PROMPT%", "clip": ["4", 1]}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "%NEGATIVE%", "clip": ["4", 1]}
  },
  "10": {
    "class_type": "VAEEncodeForInpaint",
    "inputs": {"pixels": ["1", 0], "vae": ["4", 2], "mask": ["1", 1], "grow_mask_by": 8}
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "%SEED%",
      "steps": 28,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["10", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["3", 0], "vae": ["4", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "nostalgia_inpaint", "images": ["8", 0]}
  }
}
