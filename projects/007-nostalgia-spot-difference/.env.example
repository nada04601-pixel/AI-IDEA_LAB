# .env.example 을 .env 로 복사해서 수정하세요. (.env 는 Git에 올라가지 않습니다)

# ---- 이미지 원본 ----
# procedural : 내장 손그림 장면 (GPU 불필요, 기본값)
# sample     : assets/sample_images/ 의 그림 사용
# comfyui    : 로컬 ComfyUI로 생성 (3단계)
IMAGE_SOURCE=procedural

# 난이도: easy(차이 3개) | normal(5개) | hard(7개)
DIFFICULTY=normal

# 한글 글꼴 경로 (비워 두면 assets/fonts → 운영체제 기본 글꼴 순서로 찾음)
FONT_PATH=

# 배경음악 음량 (assets/music 에 음악 파일을 넣었을 때만 사용, 0.0~1.0)
MUSIC_VOLUME=0.18

# 생성·검사 실패 시 재시도 횟수
MAX_RETRIES=3

# ---- ComfyUI (IMAGE_SOURCE=comfyui 일 때) — 설정 방법: docs/comfyui-windows.md ----
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=workflows/comfyui_workflow.json
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_TIMEOUT=300
# SDXL 기본 해상도 중 10:7에 가장 가까운 크기
COMFYUI_WIDTH=1216
COMFYUI_HEIGHT=832
# 생긴/사라진 물건 차이를 인페인팅으로 그리기
COMFYUI_INPAINT=true
COMFYUI_INPAINT_WORKFLOW=workflows/comfyui_inpaint.json
# 비우면 COMFYUI_CHECKPOINT 사용
COMFYUI_INPAINT_CHECKPOINT=
# ComfyUI가 꺼져 있으면 자동 실행 (예약 실행용, 선택)  예) C:\AI\ComfyUI_windows_portable\run_nvidia_gpu.bat
COMFYUI_START_CMD=

# ---- YouTube 업로드 (4단계) ----
# 기본은 꺼짐. 켜더라도 공개 상태는 private(비공개)입니다.
UPLOAD_ENABLED=false
UPLOAD_PRIVACY=private
# public/unlisted 로 올리려면 아래 값을 직접 true 로 바꿔야 합니다. (사용자 명시 승인)
ALLOW_PUBLIC_UPLOAD=false
YOUTUBE_CLIENT_SECRETS=credentials.json
YOUTUBE_TOKEN=token.json
# 24 = 엔터테인먼트
YOUTUBE_CATEGORY_ID=24
MADE_FOR_KIDS=false
# auto: AI 생성 이미지(comfyui)일 때만 "변경되거나 합성된 콘텐츠"로 표시 | true | false
DECLARE_SYNTHETIC_MEDIA=auto

# ---- 예약 실행 (5단계) ----
# 하루에 만들 영상 수. 처음 1주일은 1로 두고 결과를 확인한 뒤 늘리세요.
DAILY_COUNT=1
