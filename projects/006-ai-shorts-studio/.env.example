# 이 파일을 .env로 복사해 사용한다. .env는 Git에 올리지 않는다.
# 실제 API 키는 이 파일이 아니라 .env에만 적는다.

# 백엔드
# AISS_STORAGE_DIR=./storage            # SQLite DB와 생성 자산 저장 위치 (기본: projects/006-ai-shorts-studio/storage)
# AISS_DATABASE_URL=sqlite:///./storage/app.db  # 지정하면 AISS_STORAGE_DIR 대신 사용
# AISS_CORS_ORIGINS=http://localhost:3000
# AISS_SCRIPT_PROVIDER=mock               # 대본·스토리보드 공급자 (현재 mock만 지원, 외부 호출·비용 없음)
# AISS_IMAGE_PROVIDER=mock                # 장면 이미지 공급자 (현재 mock만 지원)
# AISS_VIDEO_PROVIDER=mock                # 장면 영상 공급자 (현재 mock만 지원, FFmpeg 필요)
# AISS_AUDIO_PROVIDER=mock                # 장면 음성(TTS) 공급자 (현재 mock만 지원)
# AISS_FFMPEG_PATH=/usr/bin/ffmpeg        # PATH에 ffmpeg가 없을 때만 지정
# AISS_SUBTITLE_FONT=Malgun Gothic        # 영상에 입히는 자막 글꼴 (비우면 시스템이 한글 글꼴로 대체)

# 프런트엔드 (frontend/.env.local에 적는다)
# NEXT_PUBLIC_API_BASE=http://localhost:8000
