# 네이버 커머스API센터(apicenter.commerce.naver.com) > 애플리케이션 등록에서 받은 값
# 애플리케이션의 "API 호출 IP"에 이 프로그램을 돌릴 컴퓨터의 공인 IP를 꼭 등록하세요.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=

# 도매꾹 > OpenAPI > API 발급/관리에서 받은 키. 주문(setOrder)은 Private API 권한 승인이 필요합니다.
DOMEME_API_KEY=
# 주문용 도매꾹 사업자 회원 아이디·비밀번호(SNS 가입 회원은 비밀번호를 따로 설정해야 함)
DOMEME_USER_ID=
DOMEME_PASSWORD=
# 이 컴퓨터의 공인 IP(도매꾹 로그인 API 필수값)
DOMEME_CLIENT_IP=
# 현금영수증 자동 발행(1 발행, 0 안 함)
DOMEME_CASH_RECEIPT=1
